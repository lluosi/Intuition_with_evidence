# Mem-Gallery checkout containing benchmark/data/dialog and benchmark/data/image.
MEM_GALLERY_ROOT=/path/to/Mem-Gallery

# Memory extraction and caption decisions use an OpenAI-compatible chat API.
MEMORY_API_KEY=
MEMORY_API_BASE=https://your-api-host/v1
MEMORY_MODEL=your-memory-model
MEMORY_RESULT_DIR=results

# local: model directory; api: model name plus endpoint/key below.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=/path/to/embedding-model
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=

# Only needed for python build_memory.py --answer-backend api.
ANSWER_MODEL=
ANSWER_API_KEY=
ANSWER_API_BASE=

# Optional overrides:
# MEM_GALLERY_PROMPT_DIR=/path/to/prompts
# MEMORY_TIMEOUT=300
# MEMORY_MAX_RETRIES=3
# MEMORY_RETRY_DELAY=20
# MEMORY_JSON_RETRIES=2
